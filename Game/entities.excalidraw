    },
    {
      "id": "nADfFlK75O89_2NPpxYPK",
      "type": "text",
      "x": 275.68017578125,
      "y": 1044,
      "width": 560.11962890625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
      "roundness": null,
      "seed": 1639881188,
      "version": 930,
      "versionNonce": 1990313572,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793976567522,
      "link": null,
      "locked": false,
      "text": "В режиме атаки игрок может выбрать персонажа,\nподвинуть его и атаковать - и так со всеми персонажами.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "В режиме атаки игрок может выбрать персонажа,\nподвинуть его и атаковать - и так со всеми персонажами.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "X5GwMOxrWe5SE1FmWzvLP",
      "type": "text",
      "x": 279.940185546875,
      "y": 1140,
      "width": 619.4595947265625,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 118816732,
      "version": 1307,
      "versionNonce": 1256413668,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793976567522,
      "link": null,
      "locked": false,
      "text": "Для выбора персонажа:\n- [S]elect\nДля выхода из режима атаки:\n- [E]scape\n\nВсе персонажи, которые не завершили еще ход, помечены\nзакрашенным фоном соответствующего цвета,\nостальные - прозрачного фона.\n\nЕсли доступных персонажей нет - выходим из режима [A]ttack",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Для выбора персонажа:\n- [S]elect\nДля выхода из режима атаки:\n- [E]scape\n\nВсе персонажи, которые не завершили еще ход, помечены\nзакрашенным фоном соответствующего цвета,\nостальные - прозрачного фона.\n\nЕсли доступных персонажей нет - выходим из режима [A]ttack",
      "autoResize": true,
      "lineHeight": 1.25
    },
